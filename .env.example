# Copie para ".env" e ajuste. Todas as variáveis são opcionais.

# development | production
RFM_ENV=development

# Pasta de dados (banco SQLite, backups e logs). Padrão: ./data
# RFM_DATA_DIR=C:\RFM\dados

# Banco de dados. Padrão: SQLite em <pasta de dados>/rfm.db
# PostgreSQL (produção): instale requirements-postgres.txt e use
# RFM_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/rfm

# DEBUG | INFO | WARNING | ERROR
RFM_LOG_LEVEL=INFO
